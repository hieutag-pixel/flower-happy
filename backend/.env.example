# Sao chép file này thành ".env" rồi sửa lại nếu cần
PORT=5000

# MongoDB cài trên máy (MongoDB Community Server)
MONGODB_URI=mongodb://127.0.0.1:27017/flower_happy
# Hoặc MongoDB Atlas (trên mạng), ví dụ:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flower_happy

# Chuỗi bí mật để ký token đăng nhập - đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET=doi_chuoi_nay_thanh_chuoi_bi_mat_cua_ban
JWT_EXPIRES_IN=7d

# Phí giao hàng (VND)
SHIPPING_FEE=30000
FREE_SHIP_FROM=500000
# Tiền tăng/giảm số cành tính theo "Giá mỗi cành" của từng loại hoa (quản lý trong trang admin).
# Phụ thu cho "Yêu cầu của khách hàng" do cửa hàng báo giá thủ công trên từng đơn.
